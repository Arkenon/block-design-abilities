{
    "name": "arkenon/block-design-abilities",
    "description": "Create or modify block templates, pages, posts or patterns using AI.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4",
        "chubes4/html-to-blocks-converter": "^0.6.12"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../html-to-blocks-converter",
            "options": {
                "symlink": false,
                "versions": {
                    "chubes4/html-to-blocks-converter": "0.6.12"
                }
            }
        }
    ],
    "config": {
        "allow-plugins": {
            "composer/installers": false
        }
    }
}